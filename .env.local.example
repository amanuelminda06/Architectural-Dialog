# Copy to .env.local and fill in your Supabase project keys.
# Get these from: Supabase Dashboard → Project → Settings → API
# (or from a local stack started with `supabase start`).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Either an ANON key (legacy) or the newer PUBLISHABLE key is accepted —
# the app reads NEXT_PUBLIC_SUPABASE_ANON_KEY first, then falls back to
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR-KEY